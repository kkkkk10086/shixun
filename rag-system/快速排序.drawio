<mxfile host="app.diagrams.net">
  <diagram id="page-1" name="快速排序">
    <mxGraphModel dx="1002" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="input" value="输入数组 A[0..n-1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="check" value="if (low &lt; high)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="partition" value="pivot_index = partition(A, low, high)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="290" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="left" value="quicksort(A, low, pivot_index-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="370" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="right" value="quicksort(A, pivot_index+1, high)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="370" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="start" target="input">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="420" y="100" as="sourcePoint" />
            <mxPoint x="420" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c2" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="input" target="check">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="420" y="170" as="sourcePoint" />
            <mxPoint x="420" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c3" value="是" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="check" target="partition">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="420" y="260" as="sourcePoint" />
            <mxPoint x="420" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c4" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="partition" target="left">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="350" y="330" as="sourcePoint" />
            <mxPoint x="220" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c5" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="partition" target="right">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="490" y="330" as="sourcePoint" />
            <mxPoint x="620" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c6" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="left" target="end">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="220" y="410" as="sourcePoint" />
            <mxPoint x="420" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c7" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="right" target="end">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="410" as="sourcePoint" />
            <mxPoint x="420" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c8" value="否" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="check" target="end">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="500" y="230" as="sourcePoint" />
            <mxPoint x="420" y="450" as="targetPoint" />
            <Array as="points">
              <mxPoint x="580" y="230" />
              <mxPoint x="580" y="480" />
              <mxPoint x="420" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="快速排序流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="0" width="120" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-2" name="Partition 函数">
    <mxGraphModel dx="1002" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p-start" value="Partition(A, low, high)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p-pivot" value="pivot = A[high]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p-i" value="i = low - 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p-loop" value="for j from low to high-1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="270" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p-if" value="if A[j] &lt;= pivot?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="310" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p-inc" value="i = i + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="430" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p-swap" value="swap(A[i], A[j])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="430" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p-last" value="swap(A[i+1], A[high])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="530" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p-ret" value="return i + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="370" y="600" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p-end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="670" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pc1" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="p-start" target="p-pivot">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pc2" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="p-pivot" target="p-i">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pc3" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="p-i" target="p-loop">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pc4" value="是" style="endArrow=block;html=1;" edge="1" parent="1" source="p-if" target="p-inc">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="370" y="370" as="sourcePoint" />
            <mxPoint x="290" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pc5" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="p-inc" target="p-swap">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="340" y="447" as="sourcePoint" />
            <mxPoint x="460" y="447" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pc6" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p-swap" target="p-last">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="520" y="465" as="sourcePoint" />
            <mxPoint x="420" y="530" as="targetPoint" />
            <Array as="points">
              <mxPoint x="520" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pc7" value="否" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p-if" target="p-last">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="470" y="340" as="sourcePoint" />
            <mxPoint x="420" y="530" as="targetPoint" />
            <Array as="points">
              <mxPoint x="600" y="340" />
              <mxPoint x="600" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pc8" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="p-last" target="p-ret">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pc9" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="p-ret" target="p-end">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>